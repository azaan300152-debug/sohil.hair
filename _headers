# Netlify Cache-Control & Performance Headers

# Long-term caching for static media (images, videos, fonts)
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.mp4
  Cache-Control: public, max-age=31536000, immutable
/*.jfif
  Cache-Control: public, max-age=31536000, immutable

# Caching for media subdirectories
/h/*
  Cache-Control: public, max-age=31536000, immutable
/image/*
  Cache-Control: public, max-age=31536000, immutable

# Web fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Stylesheets and scripts
/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML documents: revalidate to show updates immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: public, max-age=0, must-revalidate

