rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is an authorized admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Public gallery collection: anyone can read; ONLY admins can write/delete
    match /gallery/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Admins collection: only authenticated users can read their own doc; no public write
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only manageable via Firebase Console or Admin SDK
    }
  }
}
